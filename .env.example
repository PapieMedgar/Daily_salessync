# Email Configuration for Daily Reports
# Copy this file to .env and fill in your email settings

# SMTP Server Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Sender Email Credentials
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password

# Recipients (comma-separated list of email addresses)
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com,recipient3@example.com

# Database Configuration (if not already set)
# SALESYNC_TABLE_USERS=users
# SALESYNC_TABLE_CHECKINS=checkins
# SALESYNC_TABLE_VISIT_RESPONSE=visit_response